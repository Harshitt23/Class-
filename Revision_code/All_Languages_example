1. JavaScript
function greet(name) {
  return `Hello ${name}`;
}



console.log(greet("Harshit"));
2. TypeScript
function greet(name: string): string {
  return `Hello ${name}`;
}



console.log(greet("Harshit"));
3. Python
def greet(name):
    return f"Hello {name}"



print(greet("Harshit"))
4. Java
public class Main {
    public static void main(String[] args) {
        String name = "Harshit";
        System.out.println("Hello " + name);
    }
}



5. Go (Golang)
package main

import "fmt"

func main() {
    name := "Harshit"
    fmt.Println("Hello", name)
}



6. Rust
fn main() {
    let name = "Harshit";
    println!("Hello {}", name);
}



7. C++
#include <iostream>
using namespace std;

int main() {
    string name = "Harshit";
    cout << "Hello " << name;
    return 0;
}



8. SQL
CREATE TABLE users (
    id INT,
    name VARCHAR(50)
);

INSERT INTO users VALUES (1, 'Harshit');

SELECT * FROM users;




